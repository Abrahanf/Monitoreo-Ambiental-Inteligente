# Inicializar Git
git init
echo "__pycache__/
*.pyc
.env
*.log
venv/
.DS_Store
*.pkl
saved_models/*.pkl" > .gitignore

# Ignorar archivos de compilación de ESP-IDF
hardware/**/build/
# Ignorar configuración local
hardware/**/sdkconfig
hardware/**/sdkconfig.defaults
hardware/**/partitions.csv
